[user]
	name = Roynul Rohan
	email = roynulrohan@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[column]
	ui = auto
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt
[core]
	editor = micro
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[include]
	# Machine-only settings; the file stays out of the repo. Included last, so its values win.
	path = ~/.gitconfig.local
