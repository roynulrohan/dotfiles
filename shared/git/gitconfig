[user]
	name = Roynul Rohan
	email = roynulrohan@gmail.com
	signingkey = /home/roynul/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
	default = current
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[column]
	ui = auto
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt
[core]
	editor = micro
[gpg]
	format = ssh
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
