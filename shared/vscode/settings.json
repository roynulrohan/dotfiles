{
    // Look
    "workbench.colorTheme": "Atom One Dark",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.activityBar.location": "top",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono Nerd Font Mono', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.renderWhitespace": "trailing",
    "editor.minimap.autohide": "mouseover",
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.list.smoothScrolling": true,
    "diffEditor.hideUnchangedRegions.enabled": true,

    // Saving and formatting. Auto save doesn't format; Ctrl+S formats, applies
    // ESLint fixes and removes unused imports.
    "files.autoSave": "afterDelay",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.removeUnusedImports": "explicit"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // Prettier fallbacks, only for files outside a project with its own config.
    "prettier.singleQuote": true,
    "prettier.jsxSingleQuote": true,
    "prettier.bracketSameLine": true,
    "prettier.tabWidth": 4,
    "prettier.printWidth": 160,

    // Suggestions: inline completions win over the suggest widget.
    "editor.quickSuggestions": {
        "other": "offWhenInlineCompletions",
        "comments": "off",
        "strings": "off"
    },
    "github.copilot.nextEditSuggestions.enabled": true,

    // TypeScript / JavaScript
    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.preferences.importModuleSpecifierEnding": "minimal",
    "javascript.preferences.importModuleSpecifierEnding": "minimal",
    "typescript.preferences.preferTypeOnlyAutoImports": true,

    // Git and GitHub
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "githubPullRequests.pullBranch": "never",
    "githubPullRequests.createOnPublishBranch": "never",
    "explorer.confirmDelete": false,

    // Terminal, per OS (Settings Sync carries this file to every machine)
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.defaultProfile.linux": "fish",
    "terminal.integrated.defaultProfile.osx": "fish",
    "terminal.integrated.profiles.windows": {
        "PowerShell 7": {
            "path": "pwsh.exe",
            "args": ["-NoLogo"],
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell 7",

    // GitHub workflow files get their schema from the GitHub Actions extension.
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://spec.openapis.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://biomejs.dev": true
    }
}
