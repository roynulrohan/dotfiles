#!/bin/bash
# ~/.config/borders/bordersrc
# JankyBorders — draws colored outlines around yabai-managed windows.
# Replaces yabai's removed built-in window_border. Runs as its own service.
#
# Colors match the Catppuccin Macchiato palette used by sketchybar:
#   active   = Catppuccin white (same as sketchybar label color)
#   inactive = dimmer cool grey
#
# Run-time controls (from any shell):
#   brew services start   borders
#   brew services stop    borders
#   brew services restart borders
#   borders width=3.0     # re-tune live without restart

options=(
  style=round
  width=5.0
  hidpi=off
  active_color=0xffe1e3e4
  inactive_color=0xff2a2f38
  background_color=0x00000000
)

borders "${options[@]}"
