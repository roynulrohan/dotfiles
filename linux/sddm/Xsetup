#!/bin/sh
# SDDM runs this as root before the X11 login screen appears (DisplayCommand
# in x11.conf). Show the login screen on the main monitor only and turn the
# others off; X11 mirrors every monitor otherwise. Hyprland sets its own layout
# after login, so this affects the login screen only.
#
# The main monitor is the one whose EDID model name contains MAIN_MODEL. X11's
# output names don't match Hyprland's (X called the left VG248 "DP-2"), and X11
# offered the VG248 a higher refresh rate than the VG279QM, so neither the name
# nor the refresh rate is reliable. If no connected monitor matches, the one
# with the highest refresh rate wins.
# XSETUP_DRY_RUN=1 prints the xrandr command instead of running it.

MAIN_MODEL=VG279QM

# The connected output whose EDID monitor name (descriptor tag 0xfc) contains
# MAIN_MODEL, from `xrandr --verbose`.
named=$(xrandr --verbose | awk -v want="$MAIN_MODEL" '
    BEGIN { for (i = 0; i < 256; i++) val[sprintf("%02x", i)] = i }
    function byte(h, i) { return val[substr(h, 2 * i + 1, 2)] }
    function edid_name(h,    d, o, i, c, s) {
        for (d = 0; d < 4; d++) {
            o = 54 + 18 * d
            if (byte(h, o) || byte(h, o + 1) || byte(h, o + 2) || byte(h, o + 3) != 252) continue
            s = ""
            for (i = o + 5; i < o + 18; i++) { c = byte(h, i); if (c == 10) break; s = s sprintf("%c", c) }
            return s
        }
        return ""
    }
    function check() { if (out != "" && hex != "" && index(edid_name(hex), want)) found = out; hex = ""; inedid = 0 }
    /^[^ \t]/ { check(); out = ($2 == "connected") ? $1 : ""; next }
    /^[ \t]+EDID:/ { check(); inedid = 1; next }
    inedid && /^[ \t]+[0-9a-f]+$/ { line = $0; gsub(/[ \t]/, "", line); hex = hex line; next }
    inedid { check() }
    END { check(); if (found != "") print found }')

args=$(xrandr --query | awk -v named="$named" '
    $2 == "disconnected" { out = ""; next }
    $2 == "connected"    { out = $1; outs[++n] = out; best[out] = 0; next }
    /^[ \t]/ && out != "" {
        for (i = 2; i <= NF; i++) {
            r = $i; gsub(/[^0-9.]/, "", r)
            if (r + 0 > best[out]) best[out] = r + 0
        }
    }
    END {
        if (n == 0) exit
        main = outs[1]
        for (i = 2; i <= n; i++) if (best[outs[i]] > best[main]) main = outs[i]
        if (named != "" && (named in best)) main = named
        printf "--output %s --auto --primary --pos 0x0", main
        for (i = 1; i <= n; i++) if (outs[i] != main) printf " --output %s --off", outs[i]
    }')

[ -n "$args" ] || exit 0
if [ "${XSETUP_DRY_RUN:-}" = 1 ]; then
    echo "xrandr $args"
else
    # shellcheck disable=SC2086 # output names contain no spaces
    xrandr $args
fi
