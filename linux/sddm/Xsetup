#!/bin/sh
# SDDM runs this as root before the X11 login screen appears (DisplayCommand
# in x11.conf). X11 mirrors every monitor otherwise, so this places them side
# by side in ORDER and makes the main monitor X's primary output. The theme
# shows the login on the primary monitor and a clock on the others. Hyprland
# sets its own layout after login, so this affects the login screen only.
#
# The main monitor is the one whose EDID model name contains MAIN_MODEL.
# Neither the output name nor the refresh rate is reliable: with the NVIDIA
# driver, X11 names outputs differently than Hyprland does, and X11 can offer a
# side monitor a higher refresh rate than the main one. If no connected monitor
# matches, the one with the highest refresh rate wins.
# XSETUP_DRY_RUN=1 prints the xrandr command instead of running it.

MAIN_MODEL=VG279QM
# Left to right as on the desk, by EDID model name, comma-separated. Monitors
# not listed go on the right, in xrandr's order.
ORDER="VG248,VG279QM,HP 27es"

# Each connected output and its EDID monitor name (descriptor tag 0xfc),
# tab-separated, from `xrandr --verbose`.
names=$(xrandr --verbose | awk '
    BEGIN { for (i = 0; i < 256; i++) val[sprintf("%02x", i)] = i }
    function byte(h, i) { return val[substr(h, 2 * i + 1, 2)] }
    function edid_name(h,    d, o, i, c, s) {
        for (d = 0; d < 4; d++) {
            o = 54 + 18 * d
            if (byte(h, o) || byte(h, o + 1) || byte(h, o + 2) || byte(h, o + 3) != 252) continue
            s = ""
            for (i = o + 5; i < o + 18; i++) { c = byte(h, i); if (c == 10) break; s = s sprintf("%c", c) }
            return s
        }
        return ""
    }
    function end_edid() { if (inedid) name = edid_name(hex); hex = ""; inedid = 0 }
    function flush() { end_edid(); if (out != "") print out "\t" name; out = ""; name = "" }
    /^[^ \t]/ { flush(); if ($2 == "connected") out = $1; next }
    /^[ \t]+EDID:/ { inedid = 1; hex = ""; next }
    inedid && /^[ \t]+[0-9a-f]+$/ { line = $0; gsub(/[ \t]/, "", line); hex = hex line; next }
    inedid { end_edid() }
    END { flush() }')

args=$(xrandr --query | awk -v names="$names" -v want="$MAIN_MODEL" -v order="$ORDER" '
    BEGIN {
        k = split(names, lines, "\n")
        for (i = 1; i <= k; i++) { split(lines[i], f, "\t"); model[f[1]] = f[2] }
        norder = split(order, ord, ",")
    }
    $2 == "disconnected" { out = ""; next }
    $2 == "connected"    { out = $1; outs[++n] = out; best[out] = 0; width[out] = 0; next }
    /^[ \t]/ && out != "" {
        # Mode lines: "1920x1080  60.00*+ 144.00". --auto picks the mode
        # marked "+" (preferred), else the first one.
        w = $1; sub(/x.*/, "", w)
        if (width[out] == 0 || (!pref[out] && index($0, "+"))) { width[out] = w + 0; if (index($0, "+")) pref[out] = 1 }
        for (i = 2; i <= NF; i++) {
            r = $i; gsub(/[^0-9.]/, "", r)
            if (r + 0 > best[out]) best[out] = r + 0
        }
    }
    END {
        if (n == 0) exit
        main = outs[1]
        for (i = 2; i <= n; i++) if (best[outs[i]] > best[main]) main = outs[i]
        for (i = 1; i <= n; i++) if (index(model[outs[i]], want)) { main = outs[i]; break }
        # Sort by position in ORDER; unlisted monitors keep xrandr order after them.
        for (i = 1; i <= n; i++) {
            rank[i] = norder + i
            for (j = 1; j <= norder; j++) if (index(model[outs[i]], ord[j])) { rank[i] = j; break }
            idx[i] = i
        }
        for (i = 2; i <= n; i++)
            for (j = i; j > 1 && rank[idx[j]] < rank[idx[j - 1]]; j--) { t = idx[j]; idx[j] = idx[j - 1]; idx[j - 1] = t }
        x = 0
        for (i = 1; i <= n; i++) {
            o = outs[idx[i]]
            printf "%s--output %s --auto --pos %dx0", (i > 1 ? " " : ""), o, x
            if (o == main) printf " --primary"
            x += width[o]
        }
    }')

[ -n "$args" ] || exit 0
if [ "${XSETUP_DRY_RUN:-}" = 1 ]; then
    echo "xrandr $args"
else
    # shellcheck disable=SC2086 # output names contain no spaces
    xrandr $args
fi
