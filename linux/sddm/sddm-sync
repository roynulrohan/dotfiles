#!/bin/sh
# Refresh the login screen's synced assets folder now. Runs as you, no sudo.
# Noctalia keeps the colours, the still and the GIF fresh by itself (SETUP.md,
# "How it stays in sync"). Run this once after setup, and after you change the
# login video, your face picture (~/.face) or Noctalia's weather location.
# LOGIN_VIDEO overrides the video. SDDM_ASSETS overrides the folder for a dry
# run, which then skips the colours and still: Noctalia writes those to
# /var/lib/sddm-assets only.
set -e
dir=${SDDM_ASSETS:-/var/lib/sddm-assets}
video=${LOGIN_VIDEO:-$HOME/Pictures/Wallpapers/live/login.mp4}

if [ ! -w "$dir" ]; then
    echo "$dir is missing or not writable; see linux/sddm/SETUP.md" >&2
    exit 1
fi

# put <source> <name>: copy a file in, readable by the greeter (user sddm).
put() {
    if [ -f "$1" ]; then
        install -Dm 644 "$1" "$dir/$2"
        echo "✓ $2"
    else
        echo "skipped $2: no $1" >&2
    fi
}

put "$video" background.mp4
put "$HOME/.face" "faces/$(id -un).face.icon"
put "$HOME/.cache/noctalia/location.json" location.json
put "$(readlink -f "$HOME/.local/share/noctalia/lock/current.gif")" current.gif

# Colours and still: Noctalia renders its templates again, and the sddm
# entry's hook copies the wallpaper (linux/noctalia/config.toml).
if [ -z "${SDDM_ASSETS:-}" ]; then
    noctalia msg templates-apply
fi
