{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "bar": {
        "persistent": true,
        "popouts": {
            "activeWindow": false
        },
        "showOnHover": true,
        "workspaces": {
            "activeLabel": "",
            "displayType": "Text",
            "label": "",
            "occupiedLabel": "",
            "shown": 5
        }
    },
    "dashboard": {
        "enabled": true
    },
    "sidebar": {
        "enabled": true
    },
    "services": {
        "weatherLocation": "45.4215,-75.6972"
    },
    "session": {
        "commands": {
            "logout": [
                "uwsm",
                "stop"
            ]
        }
    },
    "lock": {
        "hideNotifs": true,
        "useWallpaper": true
    },
    "general": {
        "idle": {
            "timeouts": [
                {
                    "timeout": 3600,
                    "idleAction": "lock"
                },
                {
                    "timeout": 5400,
                    "idleAction": "dpms off",
                    "returnAction": "dpms on"
                },
                {
                    "timeout": 14400,
                    "idleAction": [
                        "systemctl",
                        "suspend"
                    ]
                }
            ]
        }
    },
    "launcher": {
        "actions": [
            {
                "name": "Calculator",
                "icon": "calculate",
                "description": "Do simple math equations (powered by Qalc)",
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Scheme",
                "icon": "palette",
                "description": "Change the current colour scheme",
                "command": [
                    "autocomplete",
                    "scheme"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Wallpaper",
                "icon": "image",
                "description": "Change the current wallpaper",
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Variant",
                "icon": "colors",
                "description": "Change the current scheme variant",
                "command": [
                    "autocomplete",
                    "variant"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Random",
                "icon": "casino",
                "description": "Switch to a random wallpaper",
                "command": [
                    "caelestia",
                    "wallpaper",
                    "-r"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Light",
                "icon": "light_mode",
                "description": "Change the scheme to light mode",
                "command": [
                    "setMode",
                    "light"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Dark",
                "icon": "dark_mode",
                "description": "Change the scheme to dark mode",
                "command": [
                    "setMode",
                    "dark"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Restart shell",
                "icon": "restart_alt",
                "description": "Restart caelestia's shell (fixes bar and panel glitches)",
                "command": [
                    "sh",
                    "-c",
                    "qs -c caelestia kill; sleep .2; caelestia shell -d"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Reload Hyprland",
                "icon": "refresh",
                "description": "Re-read the Hyprland config; puts workspaces back on their monitors",
                "command": [
                    "hyprctl",
                    "reload"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Restart wallpapers",
                "icon": "wallpaper",
                "description": "Restart the live wallpapers",
                "command": [
                    "sh",
                    "-c",
                    "$HOME/.local/bin/live-wallpaper"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Night light off",
                "icon": "wb_sunny",
                "description": "Turn the night light off until the next login",
                "command": [
                    "hyprctl",
                    "hyprsunset",
                    "identity"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Night light on",
                "icon": "nightlight",
                "description": "Back to the configured warmth",
                "command": [
                    "hyprctl",
                    "hyprsunset",
                    "reset"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Battery",
                "icon": "battery_full",
                "description": "Show the charge of wireless devices (mice, controllers)",
                "command": [
                    "sh",
                    "-c",
                    "b=$(upower -d | awk '/^Device:/{m=\"\";p=\"\";s=\"\"} /^ +model:/{sub(/^ +model: +/,\"\");sub(/^(Logitech|Sony Interactive Entertainment) /,\"\");sub(/ Wireless Controller$/,\"\");m=$0} /^ +state:/{s=\" (\"$2\")\"} /^ +percentage:/{p=$2} /^$/{if(m!=\"\"&&p!=\"\")print m\": \"p s;m=\"\"}'); notify-send -e -a Battery Battery \"${b:-No battery devices connected}\""
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Shutdown",
                "icon": "power_settings_new",
                "description": "Shutdown the system",
                "command": [
                    "poweroff"
                ],
                "enabled": true,
                "dangerous": true
            },
            {
                "name": "Reboot",
                "icon": "cached",
                "description": "Reboot the system",
                "command": [
                    "reboot"
                ],
                "enabled": true,
                "dangerous": true
            },
            {
                "name": "Logout",
                "icon": "exit_to_app",
                "description": "Log out of the current session",
                "command": [
                    "logout"
                ],
                "enabled": true,
                "dangerous": true
            },
            {
                "name": "Lock",
                "icon": "lock",
                "description": "Lock the current session",
                "command": [
                    "loginctl",
                    "lock-session"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Sleep",
                "icon": "bedtime",
                "description": "Suspend the PC",
                "command": [
                    "systemctl",
                    "suspend"
                ],
                "enabled": true,
                "dangerous": false
            },
            {
                "name": "Settings",
                "icon": "settings",
                "description": "Configure the shell",
                "command": [
                    "caelestia",
                    "shell",
                    "nexus",
                    "open"
                ],
                "enabled": true,
                "dangerous": false
            }
        ]
    }
}
