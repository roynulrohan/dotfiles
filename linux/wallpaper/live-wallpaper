#!/bin/sh
# Live wallpapers: one Wallpaper Engine Workshop wallpaper per monitor, played by
# linux-wallpaperengine, run by live-wallpaper.service. Only connected monitors
# get one.
#   live-wallpaper              restart the service, e.g. after plugging a
#                               monitor in
#   live-wallpaper --run        what the service runs (foreground; output goes
#                               to the journal: journalctl --user -u live-wallpaper)
#   live-wallpaper --if-over MIB  restart the service only when the wallpapers
#                               use more than MIB of memory (PSS): for the watchdog
# LIVE_WALLPAPER_DRY_RUN=1 prints the linux-wallpaperengine command instead.

# The picks stay on each machine, out of this repo (SETUP.md, "Picks"):
#   <monitor> <wallpaper> [title]   a Workshop ID or the name of a local copy
#   property <name>=<value>         passed to every wallpaper as --set-property
picks="${XDG_CONFIG_HOME:-$HOME/.config}/live-wallpaper/picks"
copies="${XDG_DATA_HOME:-$HOME/.local/share}/live-wallpapers"

if [ "${1:-}" = --if-over ]; then
    pid=$(pgrep -f '^\./linux-wallpaperengine' | head -n 1)
    [ -n "$pid" ] || exit 0
    pss=$(awk '/^Pss:/ { print int($2 / 1024) }' "/proc/$pid/smaps_rollup" 2>/dev/null)
    [ "${pss:-0}" -gt "${2:?usage: live-wallpaper --if-over MIB}" ] || exit 0
    echo "live-wallpaper: restarting, it uses ${pss} MiB (limit $2)" >&2
    exec systemctl --user restart live-wallpaper.service
fi

if [ "${1:-}" != --run ] && [ "${LIVE_WALLPAPER_DRY_RUN:-}" != 1 ]; then
    exec systemctl --user restart live-wallpaper.service
fi

[ -r "$picks" ] || { echo "live-wallpaper: no picks; write them to $picks" >&2; exit 1; }

# Hyprland may still be setting up outputs right after login.
i=0
until connected=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null) && [ -n "$connected" ]; do
    i=$((i + 1)); [ "$i" -ge 20 ] && { echo "live-wallpaper: no monitors from hyprctl" >&2; exit 1; }
    sleep 0.5
done

set -- --silent
while read -r key value _; do
    [ "$key" = property ] && set -- "$@" --set-property "$value"
done < "$picks"
screens=0
while read -r monitor id _name; do
    case "$monitor" in ''|'#'*|property) continue ;; esac
    printf '%s\n' "$connected" | grep -qx "$monitor" || continue
    # A downscaled local copy (<id>-1080p, see SETUP.md) replaces the Workshop
    # original; linux-wallpaperengine reads any --bg containing a / as a folder.
    [ -d "$copies/$id-1080p" ] && id="$copies/$id-1080p"
    set -- "$@" --screen-root "$monitor" --bg "$id" --scaling fill
    screens=$((screens + 1))
done < "$picks"
[ "$screens" -gt 0 ] || { echo "live-wallpaper: none of the listed monitors is connected" >&2; exit 1; }

if [ "${LIVE_WALLPAPER_DRY_RUN:-}" = 1 ]; then
    echo linux-wallpaperengine "$@"
    exit 0
fi

# The /usr/bin wrapper execs ./linux-wallpaperengine from /opt/linux-wallpaperengine.
# Stop any copy not started by the service (an older setup ran it detached).
pkill -f '^\./linux-wallpaperengine' && sleep 1
exec linux-wallpaperengine "$@"
